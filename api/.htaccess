# Send every request that is not a real file to index.php, passing the path as
# ?_route=... That is what turns /api/reports/12 into one PHP entry point.
RewriteEngine On

# Leave real files alone (none yet, but uploaded photos will live here).
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?_route=$1 [QSA,L]

# Never list the directory if the rewrite is ever switched off.
Options -Indexes
